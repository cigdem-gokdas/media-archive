from pymongo import MongoClient

class MediaItem:
    def get_info(self):
        raise NotImplementedError("Subclass should override this")

class Movie(MediaItem):
    def __init__(self, title, year, rating, poster, link, status):
        self.title = title
        self.year = year
        self.rating = rating
        self.poster = poster
        self.link = link
        self.status = status

    def update_rating(self, new_rating=None, imdb_score=None):
        if new_rating:
            self.rating = new_rating
        elif imdb_score:
            self.rating = str(imdb_score)

    def get_info(self):
        return f"{self.title} ({self.year}) - Rating: {self.rating} - Status: {self.status}"

class Database:
    def __init__(self):
        client = MongoClient("mongodb://localhost:27017/")
        self.db = client["movie_db"]
        self.movies = self.db["movies"]

    def setup(self):
        pass

    def add_movie(self, movie):
        same_movie = self.movies.find_one({"title": movie.title})
        if same_movie:
            print("This movie already exists.")
            return
        
        movie_data = {
            "title": movie.title,
            "year": movie.year,
            "rating": movie.rating,
            "poster": movie.poster,
            "link": movie.link,
            "status": movie.status
        }

        self.movies.insert_one(movie_data)
        print("Movie saved.")

    def list_movies(self):
        return list(self.movies.find({}, {"_id": 0}))

    def list_watched(self):
        return list(self.movies.find({"status": "watched"}, {"_id": 0}))

    def list_to_watch(self):
        return list(self.movies.find({"status": "not watched"}, {"_id": 0}))

    def delete_movie(self, title):
        result = self.movies.delete_one({"title": title})
        if result.deleted_count > 0:
            print("Movie deleted.")
        else:
            print("Movie not found.")

class PosterDownloader:
    def download(self, url, title):
        if url:
            print(f"Downloading poster for {title}... (simulation)")
        else:
            print("No URL entered.")

if __name__ == "__main__":
    db = Database()
    db.setup()
    downloader = PosterDownloader()

    print("Movie Database System (MongoDB Version)")

    try:
        while True:
            print("\na- Add Movie")
            print("b- List All Movies")
            print("c- Exit")
            print("d- Delete Movie")
            print("e- Watched Movies")
            print("f- Movies To Watch")

            choice = input("Select: ")

            if choice == "a":
                title = input("Movie Title: ")
                year = input("Year: ")
                rating = input("Rating: ")
                poster = input("Poster URL: ")
                page = input("Web Page: ")
                watched = input("Did you watch it? (y/n): ").lower()

                if watched == "y":
                    status = "watched"
                else:
                    status = "not watched"

                m = Movie(title, year, rating, poster, page, status)
                downloader.download(poster, title)
                db.add_movie(m)
                print("Done.")

            elif choice == "b":
                all_movies = db.list_movies()
                if not all_movies:
                    print("No movies yet.")
                else:
                    for m in all_movies:
                        print(m)

            elif choice == "e":
                w_list = db.list_watched()
                if not w_list:
                    print("No watched movies.")
                else:
                    for m in w_list:
                        print(m)

            elif choice == "f":
                n_list = db.list_to_watch()
                if not n_list:
                    print("No movies waiting to be watched.")
                else:
                    for m in n_list:
                        print(m)

            elif choice == "d":
                name = input("Enter movie title to delete: ")
                db.delete_movie(name)

            elif choice == "c":
                break

            else:
                print("Invalid choice.")

    except Exception as e:
        print("An error happened:", e)
